<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dictado en el chat (PAPER §25.1). Se pide al tocar el micrófono, no al abrir. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 13+: se pide al entrar por primera vez (PAPER §25.6). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sin esto, en Android 11+ isRecognitionAvailable() da false aunque el motor exista. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Sin backup ni traspaso a otro teléfono: la sesión abre historias clínicas y es de
         este dispositivo (PAPER §25.3). -->
    <application
        android:name=".app.CepiApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cepi"
        tools:targetApi="36">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">
            <!-- Compose recompone ante estos cambios sin recrear la actividad: girar el
                 teléfono no corta un login ni una carga en curso. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".notificaciones.ServicioPush"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Lo que pinta el sistema con la app cerrada (Push.kt, Canales). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="derivaciones" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notificacion" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/acento" />

        <!-- La cámara del sistema escribe la foto en nuestra caché por esta URI; sin permiso
             CAMERA propio (PAPER §25.1). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_fotos" />
        </provider>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sin backup ni traspaso a otro teléfono: la sesión abre historias clínicas y es de
         este dispositivo (PAPER §25.3). -->
    <application
        android:name=".app.CepiApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cepi"
        tools:targetApi="36">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">
            <!-- Compose recompone ante estos cambios sin recrear la actividad: girar el
                 teléfono no corta un login ni una carga en curso. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La cámara del sistema escribe la foto en nuestra caché por esta URI; sin permiso
             CAMERA propio (PAPER §25.1). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_fotos" />
        </provider>
    </application>
</manifest>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Autocompletar de contraseñas: la app es de estos dominios, que publican
	     /.well-known/apple-app-site-association con webcredentials. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:telemedicina.cepi.ec</string>
		<string>webcredentials:casos.cepi.ec</string>
	</array>
</dict>
</plist>
